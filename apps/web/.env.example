VITE_API_BASE_URL=http://localhost:3000/api/v1

# Dev-mode session bootstrap (see src/app/providers/AuthProvider.tsx) — when
# ALL THREE of these are set in your own gitignored .env.local, the app logs
# itself in on startup using that account, against the real backend. There
# is no hardcoded fallback: leave any one of them unset and this stays off.
# Never commit real credentials here.
# VITE_DEV_TENANT_CODE=
# VITE_DEV_EMAIL=
# VITE_DEV_PASSWORD=
