{
  "name": "identity-platform",
  "version": "0.1.0",
  "description": "Modular, product-agnostic Identity & Access Management platform. Phase 1 baseline extracted from TravelOS's reusable IAM core.",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "jest --config ./tests/jest-e2e.json --runInBand",
    "db:generate": "prisma generate --schema=database/prisma/schema",
    "db:build-schema": "bash database/scripts/build-schema.sh",
    "db:seed": "bash database/scripts/seed.sh",
    "db:migrate": "bash database/scripts/migrate.sh",
    "db:reset": "bash database/scripts/reset-db.sh",
    "platform:bootstrap": "ts-node database/scripts/bootstrap-platform-operator.ts",
    "web:dev": "npm run dev -w @identity-platform/web",
    "web:build": "npm run build -w @identity-platform/web",
    "web:preview": "npm run preview -w @identity-platform/web",
    "web:typecheck": "npm run typecheck -w @identity-platform/web",
    "web:lint": "npm run lint -w @identity-platform/web",
    "web:test": "npm run test -w @identity-platform/web"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/swagger": "^7.4.0",
    "@prisma/client": "^5.19.0",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "nestjs-cls": "^4.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/testing": "^10.4.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "^5.19.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
