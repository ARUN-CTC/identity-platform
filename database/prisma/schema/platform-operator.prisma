// Phase 2B.1 — the Platform Operator security boundary. See
// database/ddl/006_platform_operator.sql for the full rationale: every
// model here is platform-level (no tenantId, no RLS) and structurally
// separate from the tenant-scoped Membership/SecurityUserRole trees.

model PlatformOperator {
  id     String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId String       @unique @map("user_id") @db.Uuid
  user   SecurityUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  status String @default("ACTIVE")

  permissions PlatformOperatorPermission[]
  sessions    PlatformOperatorSession[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime? @map("updated_at") @db.Timestamptz
  updatedBy String?   @map("updated_by") @db.Uuid
  version   BigInt    @default(1)

  @@index([status], map: "idx_platform_operator_status")
  @@map("platform_operator")
}

model PlatformOperatorPermission {
  id           String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  operatorId   String             @map("operator_id") @db.Uuid
  operator     PlatformOperator   @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  permissionId String             @map("permission_id") @db.Uuid
  permission   SecurityPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy String?  @map("created_by") @db.Uuid

  @@unique([operatorId, permissionId], map: "uk_platform_operator_permission")
  @@index([operatorId], map: "idx_platform_operator_permission_operator")
  @@index([permissionId], map: "idx_platform_operator_permission_permission")
  @@map("platform_operator_permission")
}

model PlatformOperatorSession {
  id         String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  operatorId String           @map("operator_id") @db.Uuid
  operator   PlatformOperator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  deviceInfo String? @map("device_info")
  ipAddress  String? @map("ip_address")

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz

  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz
  revokedReason String?   @map("revoked_reason")

  refreshTokens PlatformOperatorRefreshToken[]

  @@index([operatorId], map: "idx_platform_operator_session_operator")
  @@map("platform_operator_session")
}

model PlatformOperatorRefreshToken {
  id         String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  sessionId  String                  @map("session_id") @db.Uuid
  session    PlatformOperatorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  operatorId String                  @map("operator_id") @db.Uuid

  tokenHash String @unique @map("token_hash")

  issuedAt  DateTime @default(now()) @map("issued_at") @db.Timestamptz
  expiresAt DateTime @map("expires_at") @db.Timestamptz

  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz

  replacedById String?                       @unique @map("replaced_by_id") @db.Uuid
  replacedBy   PlatformOperatorRefreshToken? @relation("PlatformRefreshTokenChain", fields: [replacedById], references: [id])
  replaces     PlatformOperatorRefreshToken? @relation("PlatformRefreshTokenChain")

  @@index([sessionId], map: "idx_platform_operator_refresh_token_session")
  @@index([operatorId], map: "idx_platform_operator_refresh_token_operator")
  @@map("platform_operator_refresh_token")
}
