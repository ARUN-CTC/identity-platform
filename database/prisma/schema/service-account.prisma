// Phase 2D.3 — ServiceAccount & Tenant Grant Foundation
// (docs/PHASE_2D3.md, docs/SERVICE_AUTHENTICATION_ARCHITECTURE.md,
// docs/adr/ADR-015-service-tenant-authorization.md as amended). See
// database/ddl/009_service_account.sql for the full rationale.

// The machine principal — PLATFORM-level (no tenantId, no RLS), exactly
// like Application/Product. `id` (a high-entropy, non-sequential UUID) IS
// the stable public identifier a future service-issued token's `sub` claim
// will carry — never Application.clientId, never security_user.id.
model ServiceAccount {
  id            String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  applicationId String      @map("application_id") @db.Uuid
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  name   String
  status String @default("ACTIVE") // ACTIVE | SUSPENDED | DISABLED

  // This ServiceAccount's OWN credential — never Application.clientSecretHash,
  // never shared with it (docs/SERVICE_AUTHENTICATION_ARCHITECTURE.md §2).
  credentialHash      String    @map("credential_hash")
  credentialCreatedAt DateTime  @default(now()) @map("credential_created_at") @db.Timestamptz
  credentialRevokedAt DateTime? @map("credential_revoked_at") @db.Timestamptz

  tenantGrants ServiceAccountTenantGrant[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime? @map("updated_at") @db.Timestamptz
  updatedBy String?   @map("updated_by") @db.Uuid
  version   BigInt    @default(1)

  @@unique([applicationId, name], map: "uk_service_account_application_name")
  @@index([applicationId], map: "idx_service_account_application")
  @@index([status], map: "idx_service_account_status")
  @@map("service_account")
}

// The explicit, durable, revocable record of which Tenants a ServiceAccount
// may act on — TENANT-scoped, ordinary RLS (apply_tenant_rls), exactly like
// TenantProductEntitlement. Never implies Product access on its own — see
// TenantProductEntitlement for that independent question.
model ServiceAccountTenantGrant {
  id               String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  serviceAccountId String         @map("service_account_id") @db.Uuid
  serviceAccount   ServiceAccount @relation(fields: [serviceAccountId], references: [id], onDelete: Cascade)

  status String @default("ACTIVE") // ACTIVE | SUSPENDED | REVOKED

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime? @map("updated_at") @db.Timestamptz
  updatedBy String?   @map("updated_by") @db.Uuid
  version   BigInt    @default(1)

  @@unique([serviceAccountId, tenantId], map: "uk_service_account_tenant_grant")
  @@index([tenantId], map: "idx_service_account_tenant_grant_tenant")
  @@index([serviceAccountId], map: "idx_service_account_tenant_grant_service_account")
  @@index([status], map: "idx_service_account_tenant_grant_status")
  @@map("service_account_tenant_grant")
}
