# Identity Platform — environment configuration template.
# Copy to .env for local development. Never commit the real .env file
# (see .gitignore) and never put real secrets in this template.

APP_NAME=identity-platform
APP_ENV=development
PORT=4000

# ---------------------------------------------------------------------------
# CORS (Phase 2D.11, docs/PRODUCTION_READINESS.md §Configuration)
#
# Comma-separated list of allowed browser origins, e.g.:
#   CORS_ALLOWED_ORIGINS=https://app.travelos.com,https://app.healthcare.example.com
# Unset (the local-development default) reflects any origin — never valid in
# production; validateProductionConfig refuses to start in production
# without this explicitly set, and refuses a wildcard value.
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Database — THIS PLATFORM'S OWN DATABASE ONLY.
#
# This must point at identity_platform_db, never at TravelOS's database.
# There is no TravelOS database configuration anywhere in this project —
# that variable name is listed below only to make the isolation boundary
# explicit and is never read by any code in this repository.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://identity_app:changeme@localhost:5434/identity_platform_db
# Phase 2D.11 (docs/PRODUCTION_READINESS.md §Database) — production
# deployments should bound both the pool size and how long a single
# statement may run, via Prisma/node-postgres's own DATABASE_URL query
# parameters — no application code change is required to set these:
#   ?connection_limit=10&pool_timeout=10&statement_timeout=10000
# (statement_timeout in milliseconds.) Left unset here — a bounded default
# is a deployment-sizing decision, not something this template should
# silently assume for every environment.

# Never set. Present only as a documented tripwire — if this project ever
# grows a variable with this name that actual code reads, that is a
# violation of the project's own isolation boundary (see docs/PROJECT_ISOLATION.md).
TRAVELOS_DATABASE_URL=

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-real-secret-min-32-chars
JWT_ACCESS_TOKEN_TTL=900
# "Remember me" checked at login.
JWT_REFRESH_TOKEN_TTL=2592000
# "Remember me" NOT checked at login (the default) — shorter-lived.
JWT_REFRESH_TOKEN_TTL_SHORT=86400
PASSWORD_RESET_TOKEN_TTL_HOURS=1
USER_INVITATION_TOKEN_TTL_HOURS=72

# Platform Operator sessions (docs/PLATFORM_OPERATOR_ARCHITECTURE.md) — kept
# deliberately shorter than tenant sessions given the elevated privilege a
# Platform Operator token carries.
PLATFORM_ACCESS_TOKEN_TTL=900
PLATFORM_REFRESH_TOKEN_TTL=86400

# ---------------------------------------------------------------------------
# External OAuth/OIDC tokens (Phase 2D.1, docs/KEY_MANAGEMENT_ARCHITECTURE.md)
# — RS256, structurally SEPARATE from the legacy HS256 JWT_ACCESS_SECRET
# above. Nothing above this block is affected by anything below it — the
# legacy token is never migrated (docs/adr/ADR-017-jwt-signing-key-management.md).
# ---------------------------------------------------------------------------
OAUTH_ISSUER=https://identity.example.com
OAUTH_AUDIENCE=identity-platform-default

# PEM-encoded RSA private key (PKCS8), REQUIRED in production. Store the PEM
# on ONE line with literal "\n" sequences in place of real line breaks (the
# same convention many providers use for service-account keys), e.g.:
#   OAUTH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
# Leave unset in local development (APP_ENV != production) to auto-generate
# an ephemeral, in-memory-only signing key at boot — every token signed with
# it stops verifying on the next restart; never rely on this outside local
# development. If APP_ENV=production and this is unset, the app refuses to
# start rather than silently generating production signing key material.
OAUTH_PRIVATE_KEY=

# Stable key id (kid) for OAUTH_PRIVATE_KEY. If unset, derived automatically
# from the public key's own SHA-256 fingerprint.
OAUTH_KEY_ID=

# Optional JSON array of previously-active, now-retired public keys still
# valid for verification during a rotation's overlap window (never used for
# signing): [{"kid":"...","publicKey":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"}]
OAUTH_RETIRED_PUBLIC_KEYS=

# Phase 2D.5 (docs/RESOURCE_SERVER_ARCHITECTURE.md) — where the Resource
# Server's own JwksClientService fetches public signing keys FROM, over
# plain HTTP — deliberately never the in-process SigningKeyService. A real,
# separately-deployed resource server MUST set this to the Identity
# Platform's actual reachable JWKS URL. Unset in local development, this
# defaults to this same process's own endpoint (http://localhost:<PORT>/.well-known/jwks.json).
OAUTH_JWKS_URI=

# Minimum milliseconds between JWKS refresh attempts (anti-amplification
# cooldown — an unknown/fabricated `kid` cannot force unbounded outbound
# fetches). Default: 60000 (1 minute).
OAUTH_JWKS_MIN_REFRESH_INTERVAL_MS=

# Clock-skew tolerance (seconds) the Resource Server's token validator
# applies to exp/nbf. Default: 30.
OAUTH_CLOCK_SKEW_SECONDS=

# Phase 2D.7 — OAuth Authorization Code lifetime (seconds). Deliberately
# short (target: <=60s, docs/OAUTH_ARCHITECTURE.md §5) — long enough for the
# redirect+POST round-trip, short enough to bound replay-attempt windows.
# Default: 60.
OAUTH_AUTHORIZATION_CODE_TTL_SECONDS=

# Phase 2D.9 — rate limiting for /oauth/authorize, /oauth/token, and
# /oauth/userinfo (docs/OAUTH_OPERATIONAL_HARDENING.md §Rate limiting).
# Each policy is a fixed window (ms) + a maximum request count per key
# within that window. Defaults are generous (they must never disrupt a
# legitimate client's normal retry behavior) — tune down for a
# production deployment expecting tighter abuse resistance.
OAUTH_AUTHORIZE_RATE_LIMIT_WINDOW_MS=
OAUTH_AUTHORIZE_RATE_LIMIT_MAX=
OAUTH_TOKEN_RATE_LIMIT_WINDOW_MS=
OAUTH_TOKEN_RATE_LIMIT_MAX=
OIDC_USERINFO_RATE_LIMIT_WINDOW_MS=
OIDC_USERINFO_RATE_LIMIT_MAX=

# ---------------------------------------------------------------------------
# Outbound email (invitations, password reset) — Phase 1 ships only a
# console-log dev implementation (MailerService), no real provider wired.
# These are placeholders for whichever provider a later phase adds.
# ---------------------------------------------------------------------------
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=Identity Platform

# Base URL of the (not-yet-built) web frontend — used only to compose links
# embedded in invitation/password-reset emails.
WEB_APP_BASE_URL=http://localhost:5173
